[Unit]
Description=Manta Captive Portal Redirector
After=network.target manta-hotspot.service manta-backend.service
Wants=network.target manta-hotspot.service manta-backend.service

[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__
ExecStart=/bin/bash __PROJECT_DIR__/scripts/python_service.sh scripts/captive_portal_server.py
Restart=always
RestartSec=2
StandardOutput=append:__PROJECT_DIR__/logs/portal.log
StandardError=append:__PROJECT_DIR__/logs/portal.log

[Install]
WantedBy=multi-user.target
