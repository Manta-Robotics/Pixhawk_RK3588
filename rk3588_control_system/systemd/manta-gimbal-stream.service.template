[Unit]
Description=Manta Gimbal RTSP Stream Proxy
After=network.target
Wants=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
Environment=PYTHONUNBUFFERED=1
UMask=0027
ExecStart=/bin/bash __PROJECT_DIR__/scripts/python_service.sh scripts/gimbal_rtsp_stream_server.py
Restart=always
RestartSec=2
TimeoutStopSec=10
StandardOutput=append:__PROJECT_DIR__/logs/gimbal_stream.log
StandardError=append:__PROJECT_DIR__/logs/gimbal_stream.log

[Install]
WantedBy=multi-user.target
