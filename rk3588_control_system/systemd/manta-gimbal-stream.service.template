[Unit]
Description=Manta Gimbal UDP Stream Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
ExecStart=/usr/bin/python3 __PROJECT_DIR__/scripts/gimbal_udp_stream_server.py
Restart=always
RestartSec=2
StandardOutput=append:__PROJECT_DIR__/logs/gimbal_stream.log
StandardError=append:__PROJECT_DIR__/logs/gimbal_stream.log

[Install]
WantedBy=multi-user.target
