[Unit]
Description=Manta gimbal eth0 host route
After=network-online.target
Wants=network-online.target
Before=manta-gimbal-stream.service manta-backend.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/manta/manta.env
ExecStart=/bin/bash __PROJECT_DIR__/scripts/manta_gimbal_route.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
