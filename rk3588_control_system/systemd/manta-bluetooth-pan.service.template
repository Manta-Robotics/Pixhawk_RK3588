[Unit]
Description=Manta Bluetooth PAN Control Link
After=bluetooth.service manta-backend.service
Wants=bluetooth.service manta-backend.service

[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-/etc/manta/manta.env
ExecStart=/bin/bash __PROJECT_DIR__/scripts/python_service.sh scripts/bluetooth_pan_server.py
Restart=always
RestartSec=2
StandardOutput=append:__PROJECT_DIR__/logs/bluetooth-pan.log
StandardError=append:__PROJECT_DIR__/logs/bluetooth-pan.log

[Install]
WantedBy=multi-user.target
