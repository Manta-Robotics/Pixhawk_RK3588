[Unit]
Description=Manta Dashboard Backend
After=network.target
Wants=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
Environment=NODE_ENV=production
EnvironmentFile=-/etc/manta/manta.env
UMask=0027
ExecStart=/bin/bash __PROJECT_DIR__/scripts/systemd_backend.sh
Restart=always
RestartSec=2
TimeoutStopSec=6
KillMode=control-group
StandardOutput=append:__PROJECT_DIR__/logs/server.log
StandardError=append:__PROJECT_DIR__/logs/server.log

[Install]
WantedBy=multi-user.target
