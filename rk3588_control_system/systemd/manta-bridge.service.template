[Unit]
Description=Manta C++ MAVLink and Independent Follow Control
After=network.target
Wants=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
UMask=0027
ExecStart=/bin/bash __PROJECT_DIR__/scripts/native_control_service.sh
Restart=always
RestartSec=2
TimeoutStopSec=10
StandardOutput=append:__PROJECT_DIR__/logs/mavlink.log
StandardError=append:__PROJECT_DIR__/logs/mavlink.log

[Install]
WantedBy=multi-user.target
