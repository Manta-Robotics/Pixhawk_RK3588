{
  "name": "rk3588-pixhawk-control",
  "version": "1.0.0",
  "description": "Manta RK3588 rover control, gimbal tracking, recording, and wireless dashboard",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "preview:original": "node scripts/serve-preview.mjs",
    "check": "node scripts/check_project.mjs",
    "check:config": "node scripts/validate_config.mjs",
    "test": "node --test",
    "maintenance": "npm test && npm run check && npm run build"
  },
  "keywords": [
    "RK3588",
    "Pixhawk",
    "UAV",
    "Control",
    "Dashboard"
  ],
  "author": "Manta Robotic",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.6",
    "bonjour-service": "^1.4.4",
    "express": "^4.22.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "nodemon": "^3.1.14",
    "parse5": "^7.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "engine.io": "^6.6.9",
    "socket.io-adapter": "^2.5.8",
    "socket.io-parser": "^4.2.7",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
